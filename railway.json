{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "builderConfig": {
      "nodeVersion": "20"
    }
  },
  "deploy": {
    "numInstances": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/",
    "healthcheckTimeout": 10,
    "restartPolicyDelay": 5,
    "region": "us-east1",
    "runtime": "UNSPECIFIED"
  }
}
